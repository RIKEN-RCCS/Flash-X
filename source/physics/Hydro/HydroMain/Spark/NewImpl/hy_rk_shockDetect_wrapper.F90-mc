! Compatibility with the active hy_rk_shockDetect array interface.
subroutine hy_rk_shockDetect(Uin,Vc,blkLimitsGC,loGC)
  use Hydro_data, only: hy_tiny
  use newimpl_hydro, only: HY_OK,HY_BAD_INPUT,HY_BAD_STATE
  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
  !$macro_imports
  implicit none
#include "Simulation.h"
#include "constants.h"
  integer, parameter :: rk=kind(1.0)
  integer, intent(in) :: loGC(3),blkLimitsGC(LOW:HIGH,MDIM)
  real, intent(inout) :: Uin(1:,loGC(1):,loGC(2):,loGC(3):)
  real, intent(out) :: Vc(loGC(1):,loGC(2):,loGC(3):)
  integer :: block,cellLo(3),cellHi(3),detectLo(3),detectHi(3),ndim,map(6),shockVariable
  integer :: i,j,k,status,failedCell(3),innerLo(3),innerHi(3)
  real(rk) :: densityGuard,beta,delta,sound,minPressure,minSound,divVelocity,pressureGradient,marker
  !$macro_declarations
#ifndef SHOK_VAR
  return
#else
  block=1; ndim=NDIM; shockVariable=SHOK_VAR
  cellLo=blkLimitsGC(LOW,:); cellHi=blkLimitsGC(HIGH,:)
  detectLo=cellLo; detectHi=cellHi
  detectLo(1:ndim)=cellLo(1:ndim)+1; detectHi(1:ndim)=cellHi(1:ndim)-1
  map=[DENS_VAR,VELX_VAR,VELY_VAR,VELZ_VAR,PRES_VAR,GAMC_VAR]
  densityGuard=hy_tiny; beta=0.5_rk; delta=0.1_rk
  Vc=0._rk
    status=HY_OK; failedCell=0
    if (shockVariable<=0) return
    status=HY_BAD_INPUT
    if (ndim<1 .or. ndim>3 .or. block<1 .or. any(cellHi<cellLo)) call Driver_abort("NewImpl: invalid shock detection")
    if (any(map<1) .or. any(map==shockVariable)) call Driver_abort("NewImpl: invalid shock detection")
    if (.not.all(ieee_is_finite([densityGuard,beta,delta]))) call Driver_abort("NewImpl: invalid shock detection")
    if (densityGuard<=0._rk .or. beta<0._rk .or. delta<0._rk) call Driver_abort("NewImpl: invalid shock detection")
    do k=cellLo(3),cellHi(3)
      do j=cellLo(2),cellHi(2)
        do i=cellLo(1),cellHi(1)
          failedCell=[i,j,k]
          @hy_acousticSpeed(Uin,map,block,i,j,k,densityGuard,sound,status)@
          if (status/=HY_OK) call Driver_abort("NewImpl: invalid shock detection")
          @flat_ref(Vc,block,i,j,k)@=sound
          @cell_ref(Uin,shockVariable,block,i,j,k)@=0._rk
        end do
      end do
    end do
    innerLo=cellLo; innerHi=cellHi
    innerLo(1:ndim)=cellLo(1:ndim)+1; innerHi(1:ndim)=cellHi(1:ndim)-1
    if (any(detectLo<innerLo) .or. any(detectHi>innerHi)) then
      status=HY_BAD_INPUT; call Driver_abort("NewImpl: invalid shock detection")
    end if
    do k=detectLo(3),detectHi(3)
      do j=detectLo(2),detectHi(2)
        do i=detectLo(1),detectHi(1)
          failedCell=[i,j,k]; status=HY_BAD_STATE
          @hy_shockNeighborhood(Uin,Vc,map,block,i,j,k,ndim,minPressure,minSound)@
          @hy_shockDifferences(Uin,map,block,i,j,k,ndim,divVelocity,pressureGradient)@
          if (.not.all(ieee_is_finite([divVelocity,pressureGradient]))) call Driver_abort("NewImpl: invalid shock detection")
          @hy_classifyShock(minPressure,minSound,divVelocity,pressureGradient,beta,delta,marker)@
          @cell_ref(Uin,shockVariable,block,i,j,k)@=marker
        end do
      end do
    end do
    status=HY_OK; failedCell=0
#endif
end subroutine
