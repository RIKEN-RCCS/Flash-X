!! @file

!> @ingroup HydroSpark
!!
!! @brief Computes flattening limiter
!!
!! @details
!! Get flattening limiter for the part of block/tile @p limits.
!! Initialize the limiter to one if @p flattening is false.
!! See https://doi.org/10.1006/jcph.2002.7158 for details
!!
!! @param stage           Current RK stage
!! @param starState       Input solution data
!! @param flat3d          Output flattening limiter
!! @param limits          A part of index limits for the given tile/block
!! @param loGC            Lower ghost cell index
!<

!!VARIANTS(GPU): hy_rk_getFlatteningLimiter

subroutine hy_rk_getFlatteningLimiter(stage, starState, flat3d, limits, loGC)

   use Hydro_data, ONLY: hy_threadWithinBlock, &
                         hy_flattening

   implicit none

   @M hy_DIR_TARGET_routine(vector)

#include "Simulation.h"
#include "constants.h"
#include "Spark.h"

   integer, intent(IN) :: stage, loGC(3)
   real, @M dim4gc, intent(INOUT) :: starState
   real, dimension(loGC(1):, loGC(2):, loGC(3):), intent(OUT) :: flat3d
   integer, intent(IN), dimension(LOW:HIGH, MDIM, MAXSTAGE) :: limits

   real, dimension(NDIM) :: flatTilde
   real :: beta, Z, ThisItMin
   real, parameter :: betaMin = 0.75, betaMax = 0.85
   real, parameter :: Zmin = 0.25, Zmax = 0.75
   integer :: i, j, k, ii, jj, kk

   @M hy_DIR_parallel_loop(3) &
   @M hy_DIR_shared([limits, flat3d])
   do k = limits(LOW, KAXIS, stage)-K3D*1, limits(HIGH, KAXIS, stage)+K3D*1
   do j = limits(LOW, JAXIS, stage)-K2D*1, limits(HIGH, JAXIS, stage)+K2D*1
   do i = limits(LOW, IAXIS, stage)-1, limits(HIGH, IAXIS, stage)+1
      flat3d(i, j, k) = 1.0
   end do
   end do
   end do

   ! if flattening is off, then stop this subroutine
   if (.NOT. hy_flattening) return

   @M hy_DIR_parallel_loop(3) &
   @M hy_DIR_shared([limits, starState, flat3d]) &
   @M hy_DIR_private([flatTilde, beta, Z]) &
   @M hy_DIR_private([ii, jj, kk, ThisItMin])
   do k = limits(LOW, KAXIS, stage)-K3D*1, limits(HIGH, KAXIS, stage)+K3D*1
   do j = limits(LOW, JAXIS, stage)-K2D*1, limits(HIGH, JAXIS, stage)+K2D*1
   do i = limits(LOW, IAXIS, stage)-1, limits(HIGH, IAXIS, stage)+1
   ThisItMin = 1.0
   do ii = i-1, i+1
      !1e-99 used to be TINY(1.0) but that produced Seg Faults
      beta = abs(starState(@M blkoff(PRES_VAR,ii,+1,j,+0,k,+0)) - starState(@M blkoff(PRES_VAR,ii,-1,j,+0,k,+0))) &
             /max(1e-99, abs(starState(@M blkoff(PRES_VAR,ii,+2,j,+0,k,+0)) - starState(@M blkoff(PRES_VAR,ii,-2,j,+0,k,+0))))
      Z = abs(starState(@M blkoff(PRES_VAR,ii,+1,j,+0,k,+0)) - starState(@M blkoff(PRES_VAR,ii,-1,j,+0,k,+0))) &
          /(starState(@M blk(GAMC_VAR,ii,j,k))*starState(@M blk(PRES_VAR,ii,j,k)))
      flatTilde(IAXIS) = max(0., min(1., (betaMax - beta)/(betaMax - betaMin)))
      if (starState(@M blkoff(VELX_VAR,ii,+1,j,+0,k,+0)) < starState(@M blkoff(VELX_VAR,ii,-1,j,+0,k,+0))) then
         flatTilde(IAXIS) = max(flatTilde(IAXIS), min(1., (Zmax-Z)/(Zmax-Zmin)))
      else
         flatTilde(IAXIS) = 1.0
      end if
      ThisItMin = min(ThisItMin, flatTilde(IAXIS))
   end do
   flatTilde(IAXIS) = ThisItMin
#if NDIM>1
   ThisItMin = 1.0
   do jj = j-1, j+1
      beta = abs(starState(@M blkoff(PRES_VAR,i,+0,jj,+1,k,+0)) - starState(@M blkoff(PRES_VAR,i,+0,jj,-1,k,+0))) &
             /max(1.e-99, abs(starState(@M blkoff(PRES_VAR,i,+0,jj,+2,k,+0)) - starState(@M blkoff(PRES_VAR,i,+0,jj,-2,k,+0))))
      Z = abs(starState(@M blkoff(PRES_VAR,i,+0,jj,+1,k,+0)) - starState(@M blkoff(PRES_VAR,i,+0,jj,-1,k,+0))) &
          /(starState(@M blk(GAMC_VAR,i,jj,k))*starState(@M blk(PRES_VAR,i,jj,k)))
      flatTilde(JAXIS) = max(0., min(1., (betaMax-beta)/(betaMax-betaMin)))
      if (starState(@M blkoff(VELY_VAR,i,+0,jj,+1,k,+0)) < starState(@M blkoff(VELY_VAR,i,+0,jj,-1,k,+0))) then
         flatTilde(JAXIS) = max(flatTilde(JAXIS), min(1., (Zmax-Z)/(Zmax-Zmin)))
      else
         flatTilde(JAXIS) = 1.0
      end if
      ThisItMin = min(ThisItMin, flatTilde(JAXIS))
   end do
   flatTilde(JAXIS) = ThisItMin
#if NDIM==3
   ThisItMin = 1.0
   do kk = k-1, k+1
      beta = abs(starState(@M blkoff(PRES_VAR,i,+0,j,+0,kk,+1)) - starState(@M blkoff(PRES_VAR,i,+0,j,+0,kk,-1))) &
             /max(1.e-99, abs(starState(@M blkoff(PRES_VAR,i,+0,j,+0,kk,+2)) - starState(@M blkoff(PRES_VAR,i,+0,j,+0,kk,-2))))
      Z = abs(starState(@M blkoff(PRES_VAR,i,+0,j,+0,kk,+1)) - starState(@M blkoff(PRES_VAR,i,+0,j,+0,kk,-1))) &
          /(starState(@M blk(GAMC_VAR,i,j,kk))*starState(@M blk(PRES_VAR,i,j,kk)))
      flatTilde(KAXIS) = max(0., min(1., (betaMax-beta)/(betaMax-betaMin)))
      if (starState(@M blkoff(VELZ_VAR,i,+0,j,+0,kk,+1)) < starState(@M blkoff(VELZ_VAR,i,+0,j,+0,kk,-1))) then
         flatTilde(KAXIS) = max(flatTilde(KAXIS), min(1., (Zmax-Z)/(Zmax-Zmin)))
      else
         flatTilde(KAXIS) = 1.0
      end if
      ThisItMin = min(ThisItMin, flatTilde(KAXIS))
   end do
   flatTilde(KAXIS) = ThisItMin
#endif
#endif
      ! save the solution
      flat3d(i, j, k) = minval(flatTilde(1:NDIM))
#ifdef FLAT_VAR
      starState(@M blk(FLAT_VAR,i,j,k)) = flat3d(i, j, k)
#endif
   end do
   end do
   end do

end subroutine hy_rk_getFlatteningLimiter
