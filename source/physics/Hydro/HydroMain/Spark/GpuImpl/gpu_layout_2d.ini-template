; 2D cell fields: i,j,variable,block; face fields add direction before block.
cell_ref
args=data,var,block,ix,jy,kz
definition=${data}(${ix},${jy},${var},${block})
face_ref
args=data,var,block,dir,ix,jy,kz
definition=${data}(${ix},${jy},${var},${dir},${block})
flat_ref
args=data,block,ix,jy,kz
definition=${data}(${ix},${jy},${block})
