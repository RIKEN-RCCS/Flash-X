! One launch covers all blocks; arithmetic helpers are imported unchanged from NewImpl.
module gpu_batch
  use newimpl_hydro
  use omp_lib
  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
  implicit none
  integer, parameter :: rk=selected_real_kind(15,307)
contains
  subroutine flatten(state,flat,n,nb,params,error)
    !$macro_imports
    integer,intent(in):: n,nb
    real(rk),intent(in)::state(-2:n+3,9,nb)
    real(rk),intent(inout)::flat(-2:n+3,nb)
    type(hydro_parameters),intent(in)::params
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,block,status
    real(rk)::f
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=0,n+1
        @hy_flatteningAtCell(state,(/1,2,3,4,5,6,7/),block,i,1,1,1,params,f,status)@
        error=max(error,status)
        flat(i,block)=f
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine reconstruct(state,flat,minus,plus,n,nb,params,error)
    !$macro_imports
    integer,intent(in)::n,nb
    real(rk),intent(in)::state(-2:n+3,9,nb),flat(-2:n+3,nb)
    real(rk),intent(inout)::minus(-2:n+3,7,nb),plus(-2:n+3,7,nb)
    type(hydro_parameters),intent(in)::params
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,block,v
    real(rk)::stencil(-2:2),cm(3),cp(3),wm(3),wp(3),qm,qp,f
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=0,n+1
        f=flat(i,block)
        do v=1,7
          @hy_gatherStencil(state,(/1,2,3,4,5,6,7/),block,i,1,1,(/1,0,0/),v,stencil)@
          @hy_wenoZCandidatesAndWeights(stencil,params%weno_epsilon,cm,cp,wm,wp)@
          @hy_finishReconstruction(stencil(0),f,cm,cp,wm,wp,qm,qp)@
          minus(i,v,block)=qm; plus(i,v,block)=qp
        end do
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine faces(state,minus,plus,flux,n,nb,params,error)
    !$macro_imports
    integer,intent(in)::n,nb
    real(rk),intent(in)::state(-2:n+3,9,nb),minus(-2:n+3,7,nb),plus(-2:n+3,7,nb)
    real(rk),intent(inout)::flux(1:n+1,5,nb)
    type(hydro_parameters),intent(in)::params
    integer,intent(out)::error
    integer::inputMap(7),outputMap(5),shockVariable,d,e(3)
! PRIVATE_BEGIN
    integer::i,block,j,k,status
    real(rk)::ql(7),qr(7),ul(5),ur(5),fl(5),fr(5),usl(5),usr(5),f(5),sl,sr,speed,contact,pstar
    logical::vacuum,inShock
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=1,n+1
        j=1; k=1; status=HY_OK
        cell_work: do
          ! INSERT_REFERENCE_FACE_BODY
          exit cell_work
        end do cell_work
        error=max(error,status)
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine update(reference,state,flux,integrated,n,nb,dx,dt,coeff,weight,reset,error)
    !$macro_imports
    integer,intent(in)::n,nb
    real(rk),intent(in)::reference(-2:n+3,9,nb),flux(1:n+1,5,nb),dx,dt,coeff(3),weight
    real(rk),intent(inout)::state(-2:n+3,9,nb),integrated(1:n+1,5,nb)
    logical,intent(in)::reset
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,block,v
    real(rk)::u0(5),us(5),source(5),divergence(5),updated(5),rho,velocity(3),totalEnergy,internalEnergy
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=1,n
        @hy_loadUpdateConservative(reference,(/1,2,3,4,8,7/),block,i,1,1,u0)@
        @hy_loadUpdateConservative(state,(/1,2,3,4,8,7/),block,i,1,1,us)@
        source=0
        @hy_updateFluxDivergence(flux,flux,flux,(/1,2,3,4,5/),block,i,1,1,1,(/dx,1._rk,1._rk/),divergence)@
        @hy_combineUpdate(u0,us,source,divergence,coeff,coeff(3)*dt,updated)@
        @hy_recoverUpdatedHydro(updated,1.e-12_rk,1.e-12_rk,rho,velocity,totalEnergy,internalEnergy)@
        @hy_storeUpdatedHydro(state,(/1,2,3,4,8,7/),block,i,1,1,rho,velocity,totalEnergy,internalEnergy)@
        if (.not.all(ieee_is_finite(updated))) error=max(error,HY_BAD_STATE)
      end do
    end do
    !$omp end target teams distribute parallel do
    !$omp target teams distribute parallel do collapse(2) private(i,block,v)
    do block=1,nb
      do i=1,n+1
        do v=1,5
          if(reset) integrated(i,v,block)=0
          integrated(i,v,block)=integrated(i,v,block)+weight*dt*flux(i,v,block)
        end do
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine
  subroutine batch_shocks(state,sound,n,nb,tiny,error)
    integer,intent(in)::n,nb
    real(rk),intent(inout)::state(-2:n+3,9,nb),sound(-2:n+3,nb)
    real(rk),intent(in)::tiny
    integer,intent(out)::error
    call acoustics(state,sound,n,nb,tiny,error)
    if(error/=0) return
    call markers(state,sound,n,nb,error)
  end subroutine

  subroutine acoustics(state,soundWork,n,nb,tiny,error)
    !$macro_imports
    integer,intent(in)::n,nb
    real(rk),intent(inout)::state(-2:n+3,9,nb),soundWork(-2:n+3,nb)
    real(rk),intent(in)::tiny
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::block,i,status
    real(rk)::sound
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=-2,n+3
        @hy_acousticSpeed(state,(/1,2,3,4,5,6/),block,i,1,1,tiny,sound,status)@
        error=max(error,status)
        soundWork(i,block)=sound
        state(i,9,block)=0
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine markers(state,soundWork,n,nb,error)
    !$macro_imports
    integer,intent(in)::n,nb
    real(rk),intent(inout)::state(-2:n+3,9,nb),soundWork(-2:n+3,nb)
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::block,i
    real(rk)::minPressure,minSound,divVelocity,pressureGradient,marker
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=-1,n+2
        @hy_shockNeighborhood(state,soundWork,(/1,2,3,4,5,6/),block,i,1,1,1,minPressure,minSound)@
        @hy_shockDifferences(state,(/1,2,3,4,5,6/),block,i,1,1,1,divVelocity,pressureGradient)@
        if(.not.all(ieee_is_finite((/divVelocity,pressureGradient/)))) error=max(error,HY_BAD_STATE)
        @hy_classifyShock(minPressure,minSound,divVelocity,pressureGradient,0.5_rk,0.1_rk,marker)@
        state(i,9,block)=marker
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine
  subroutine timestep_rate(state,n,nb,dx,rate,error)
    !$macro_imports
    integer,intent(in)::n,nb
    real(rk),intent(in)::state(-2:n+3,9,nb),dx
    real(rk),intent(out)::rate
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,block,status
    real(rk)::sound,cellRate,speed
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do i=1,n
        @hy_acousticSpeed(state,(/1,2,3,4,5,6/),block,i,1,1,0._rk,sound,status)@
        if(status==HY_OK) then
          @hy_uniformDtCellRate(state,(/1,2,3,4,5,6/),block,i,1,1,1,(/dx,1._rk,1._rk/),sound,cellRate,speed,status)@
          rate=max(rate,cellRate)
        end if
        error=max(error,status)
      end do
    end do
    !$omp end target teams distribute parallel do
  end subroutine
end module
