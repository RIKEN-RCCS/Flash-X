; Contiguous batch arrays: spatial index, variable, block. Initial provider is 1D.
cell_ref
args=data,var,block,ix,jy,kz
definition=${data}(${ix},${var},${block})
face_ref
args=data,var,block,dir,ix,jy,kz
definition=${data}(${ix},${var},${block})
flat_ref
args=data,block,ix,jy,kz
definition=${data}(${ix},${block})
