! One launch covers all blocks; arithmetic helpers are imported unchanged from NewImpl.
module gpu_batch_2d
  use newimpl_hydro
  use omp_lib
  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
  implicit none
  integer, parameter :: rk=selected_real_kind(15,307)
  integer, parameter :: primitiveMap(7)=[1,2,3,4,5,6,7],acousticMap(6)=[1,2,3,4,5,6]
  integer, parameter :: updateMap(6)=[1,2,3,4,8,7],conservedMap(5)=[1,2,3,4,5],xOffset(3)=[1,0,0]
contains
  subroutine flatten(state,flat,nx,ny,nb,params,error)
    !$macro_imports
    integer,intent(in):: nx,ny,nb
    real(rk),intent(in)::state(-2:nx+3,-2:ny+3,9,nb)
    real(rk),intent(inout)::flat(-2:nx+3,-2:ny+3,nb)
    type(hydro_parameters),intent(in)::params
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,j,block,status
    real(rk)::f
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=0,ny+1
      do i=0,nx+1
        @hy_flatteningAtCell(state,primitiveMap,block,i,j,1,2,params,f,status)@
        error=max(error,status)
        flat(i,j,block)=f
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine reconstruct(state,flat,minus,plus,nx,ny,nb,params,d,error)
    !$macro_imports
    integer,intent(in)::nx,ny,nb,d
    real(rk),intent(in)::state(-2:nx+3,-2:ny+3,9,nb),flat(-2:nx+3,-2:ny+3,nb)
    real(rk),intent(inout)::minus(-2:nx+3,-2:ny+3,7,nb),plus(-2:nx+3,-2:ny+3,7,nb)
    integer::e(3)
    type(hydro_parameters),intent(in)::params
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,j,block,v
    real(rk)::stencil(-2:2),cm(3),cp(3),wm(3),wp(3),qm,qp,f
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=1-e(2),ny+e(2)
      do i=1-e(1),nx+e(1)
        f=flat(i,j,block)
        do v=1,7
          @hy_gatherStencil(state,primitiveMap,block,i,j,1,e,v,stencil)@
          @hy_wenoZCandidatesAndWeights(stencil,params%weno_epsilon,cm,cp,wm,wp)@
          @hy_finishReconstruction(stencil(0),f,cm,cp,wm,wp,qm,qp)@
          minus(i,j,v,block)=qm; plus(i,j,v,block)=qp
        end do
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine faces(state,minus,plus,flux,nx,ny,nb,params,d,error)
    !$macro_imports
    integer,intent(in)::nx,ny,nb,d
    real(rk),intent(in)::state(-2:nx+3,-2:ny+3,9,nb),minus(-2:nx+3,-2:ny+3,7,nb),plus(-2:nx+3,-2:ny+3,7,nb)
    real(rk),intent(inout)::flux(1:nx+1,1:ny+1,5,2,nb)
    type(hydro_parameters),intent(in)::params
    integer,intent(out)::error
    integer::inputMap(7),outputMap(5),shockVariable,e(3)
! PRIVATE_BEGIN
    integer::i,block,j,k,status
    real(rk)::ql(7),qr(7),ul(5),ur(5),fl(5),fr(5),usl(5),usr(5),f(5),sl,sr,speed,contact,pstar
    logical::vacuum,inShock
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=1,ny+e(2)
      do i=1,nx+e(1)
        k=1; status=HY_OK
        cell_work: do
          ! INSERT_REFERENCE_FACE_BODY
          exit cell_work
        end do cell_work
        error=max(error,status)
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine update(reference,state,flux,integrated,nx,ny,nb,dx,dy,dt,coeff,weight,reset,error)
    !$macro_imports
    integer,intent(in)::nx,ny,nb
    integer::direction,ex,ey
    real(rk)::spacing(3),area
    real(rk),intent(in)::reference(-2:nx+3,-2:ny+3,9,nb),flux(1:nx+1,1:ny+1,5,2,nb),dx,dy,dt,coeff(3),weight
    real(rk),intent(inout)::state(-2:nx+3,-2:ny+3,9,nb),integrated(1:nx+1,1:ny+1,5,2,nb)
    logical,intent(in)::reset
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,j,block,v
    real(rk)::u0(5),us(5),source(5),divergence(5),updated(5),rho,velocity(3),totalEnergy,internalEnergy
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=1,ny
      do i=1,nx
        @hy_loadUpdateConservative(reference,updateMap,block,i,j,1,u0)@
        @hy_loadUpdateConservative(state,updateMap,block,i,j,1,us)@
        source=0
        @hy_updateFluxDivergence(flux,flux,flux,conservedMap,block,i,j,1,2,spacing,divergence)@
        @hy_combineUpdate(u0,us,source,divergence,coeff,coeff(3)*dt,updated)@
        @hy_recoverUpdatedHydro(updated,1.e-12_rk,1.e-12_rk,rho,velocity,totalEnergy,internalEnergy)@
        @hy_storeUpdatedHydro(state,updateMap,block,i,j,1,rho,velocity,totalEnergy,internalEnergy)@
        if (.not.all(ieee_is_finite(updated))) error=max(error,HY_BAD_STATE)
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
    do direction=1,2
      ex=0; ey=0
      if(direction==1) ex=1
      if(direction==2) ey=1
      area=dy
      if(direction==2) area=dx
      !$omp target teams distribute parallel do collapse(3) map(alloc:flux,integrated) private(i,j,block,v)
      do block=1,nb
        do j=1,ny+ey
          do i=1,nx+ex
            do v=1,5
              if(reset) integrated(i,j,v,direction,block)=0
              integrated(i,j,v,direction,block)=integrated(i,j,v,direction,block) &
                +weight*dt*area*flux(i,j,v,direction,block)
            end do
          end do
        end do
      end do
      !$omp end target teams distribute parallel do
    end do
  end subroutine

  subroutine batch_shocks(state,sound,nx,ny,nb,tiny,error)
    integer,intent(in)::nx,ny,nb
    real(rk),intent(inout)::state(-2:nx+3,-2:ny+3,9,nb),sound(-2:nx+3,-2:ny+3,nb)
    real(rk),intent(in)::tiny
    integer,intent(out)::error
    call acoustics(state,sound,nx,ny,nb,tiny,error)
    if(error/=0) return
    call markers(state,sound,nx,ny,nb,error)
  end subroutine

  subroutine acoustics(state,soundWork,nx,ny,nb,tiny,error)
    !$macro_imports
    integer,intent(in)::nx,ny,nb
    real(rk),intent(inout)::state(-2:nx+3,-2:ny+3,9,nb),soundWork(-2:nx+3,-2:ny+3,nb)
    real(rk),intent(in)::tiny
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::block,i,j,status
    real(rk)::sound
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=-2,ny+3
      do i=-2,nx+3
        @hy_acousticSpeed(state,acousticMap,block,i,j,1,tiny,sound,status)@
        error=max(error,status)
        soundWork(i,j,block)=sound
        state(i,j,9,block)=0
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
  end subroutine

  subroutine markers(state,soundWork,nx,ny,nb,error)
    !$macro_imports
    integer,intent(in)::nx,ny,nb
    real(rk),intent(inout)::state(-2:nx+3,-2:ny+3,9,nb),soundWork(-2:nx+3,-2:ny+3,nb)
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::block,i,j
    real(rk)::minPressure,minSound,divVelocity,pressureGradient,marker
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=-1,ny+2
      do i=-1,nx+2
        @hy_shockNeighborhood(state,soundWork,acousticMap,block,i,j,1,2,minPressure,minSound)@
        @hy_shockDifferences(state,acousticMap,block,i,j,1,2,divVelocity,pressureGradient)@
        if(.not.all(ieee_is_finite((/divVelocity,pressureGradient/)))) error=max(error,HY_BAD_STATE)
        @hy_classifyShock(minPressure,minSound,divVelocity,pressureGradient,0.5_rk,0.1_rk,marker)@
        state(i,j,9,block)=marker
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
  end subroutine
  subroutine timestep_rate(state,nx,ny,nb,dx,dy,rate,error)
    !$macro_imports
    integer,intent(in)::nx,ny,nb
    real(rk),intent(in)::state(-2:nx+3,-2:ny+3,9,nb),dx,dy
    real(rk)::spacing(3)
    real(rk),intent(out)::rate
    integer,intent(out)::error
! PRIVATE_BEGIN
    integer::i,j,block,status
    real(rk)::sound,cellRate,speed
    !$macro_declarations
! PRIVATE_END
    do block=1,nb
      do j=1,ny
      do i=1,nx
        @hy_acousticSpeed(state,acousticMap,block,i,j,1,0._rk,sound,status)@
        if(status==HY_OK) then
          @hy_uniformDtCellRate(state,acousticMap,block,i,j,1,2,spacing,sound,cellRate,speed,status)@
          rate=max(rate,cellRate)
        end if
        error=max(error,status)
      end do
    end do
      end do
    !$omp end target teams distribute parallel do
  end subroutine
end module
