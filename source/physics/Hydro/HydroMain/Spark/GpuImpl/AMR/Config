# Batched GPU Hydro for 2D/3D Cartesian, telescoping RK2, ordinary AMR reflux.
PPDEFINE HY_GPU_AMR
REQUIRES Grid/GridMain/AMR
REQUIRES physics/Eos/EosMain/Gamma
USESETUPVARS gpuAmrCpuTest
IF gpuAmrCpuTest
  PPDEFINE HY_GPU_AMR_CPU_TEST
  LIBRARY OMP_HOST
ELSE
  LIBRARY OMP_OL
ENDIF
PARAMETER hy_gpuBatchSize INTEGER 32

USESETUPVARS useMP5, useTVD, useFog, useLim03, useGLM, nontelescoping, omp_offload, oacc, Milhoja, threadWithinBlock, GridIndexReorder
IF useMP5 or useTVD or useFog or useLim03 or useGLM or nontelescoping or omp_offload or oacc or Milhoja or threadWithinBlock or GridIndexReorder
  SETUPERROR gpuAmr requires default WENO telescoping without legacy offload or within-block threading
ENDIF

D hy_gpuDumpInterval Dump owned cells after Hydro correction every N driver steps; zero disables.
PARAMETER hy_gpuDumpInterval INTEGER 0
D hy_gpuDumpPrefix Prefix (optionally with an existing directory) for rank-local verification CSV files.
PARAMETER hy_gpuDumpPrefix STRING "amr_verify"

D hy_gpuTimingInterval Write rank-local batch timings every N steps; zero disables CSV output.
PARAMETER hy_gpuTimingInterval INTEGER 0
D hy_gpuTimingPrefix Prefix for per-step rank-local timing CSV files.
PARAMETER hy_gpuTimingPrefix STRING "amr_timing"
