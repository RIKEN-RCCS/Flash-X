; Unified spatial-first storage; inactive z is a single unguarded plane in 2D.
cell_ref
args=data,var,block,ix,jy,kz
definition=${data}(${ix},${jy},${kz},${var},${block})
face_ref
args=data,var,block,dir,ix,jy,kz
definition=${data}(${ix},${jy},${kz},${var},${dir},${block})
flat_ref
args=data,block,ix,jy,kz
definition=${data}(${ix},${jy},${kz},${block})
